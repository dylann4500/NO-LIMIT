# Python / OS
.venv/
__pycache__/
*.pyc
.DS_Store

# Official organizer starter kit: download it from the portal into starter-kit/ (tests and reviewer tools expect it there)
starter-kit/

# Release zips ARE tracked (they're the exact files uploaded during the event)
*.zip
!releases/*.zip

# Hand histories: large, and they contain other teams' play
*.jsonl
*.jsonl.gz
hand-history/

# Regenerable analysis output (the human-readable .txt results under research/competitors/out are kept)
reviewer/out/
research/competitors/out/**/*.json

# prep/ is the pre-event training repo (samrocksnature/pokerbot), imported whole: keep its own
# self-play logs and field-bot data even though they match the patterns above
!prep/**/*.jsonl
!prep/**/*.jsonl.gz
!prep/**/*.json.gz
!prep/**/*.zip

# Local copies of the tournament hand histories (see data/README.md)
data/hands/

# prep/ generated output (mirrors the pokerbot repo's own ignores)
prep/third_party/
prep/submission/
prep/league/
prep/cluster/results/*.tmp.json
prep/lab/field_bots/*/round*/
prep/lab/field_bots/_codex_logs/

# Modal eval output (cloud/nl_modal.py)
cloud/results/
